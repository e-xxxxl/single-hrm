# ---- Runtime ----
NODE_ENV=development
PORT=5000
APP_NAME=HRM Platform

# ---- Database ----
# One database holds every organization; isolation is per document
# (organizationId), enforced by the API. The DB name in the URI is what matters.
MONGODB_URI=mongodb://127.0.0.1:27017/hrm_db

# ---- Auth ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=hrm_rt
# How long (ms) a user's role/status and their organization's status may be
# served from cache. Suspending a user or deactivating an organization takes
# effect on existing sessions within this window.
AUTH_CACHE_TTL_MS=10000

# ---- CORS / cookies ----
CLIENT_ORIGINS=http://localhost:5173
# In production (SPA on a different domain to the API) set:
#   COOKIE_SECURE=true  COOKIE_SAMESITE=none  COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- File storage ----
# local      — bytes on disk under UPLOAD_DIR/<organizationId>/ (use a persistent volume in production)
# cloudinary — authenticated (non-public) Cloudinary assets; needs the CLOUD_* keys
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ---- Reverse geocoding (GPS attendance) ----
GEOCODE_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_API_KEY=

# ---- Email (optional in dev — messages are logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HRM Platform <no-reply@localhost>

# ---- Seed (scripts/seed.js) ----
# `npm run seed` creates the Platform Admin and the four organizations
# (EsiatOptivest, PwweFoundation, VendraMart, SJI), each with one Org Admin.
# Every seeded login uses SEED_PASSWORD as a temporary password (changed at first
# sign-in); if unset, one is generated and printed. `npm run dev:mem` falls back to
# the documented dev default (Demo@12345) and adds sample HR data.
SEED_PLATFORM_ADMIN_EMAIL=platform@hrm.local
# NOTE: an unquoted # starts a comment in .env files — quote any value containing one,
# e.g. SEED_PASSWORD="Pass#123"
SEED_PASSWORD=
# Optional real Org Admin emails (default admin@<slug>.local):
SEED_ADMIN_EMAIL_ESIAT=
SEED_ADMIN_EMAIL_PWWE=
SEED_ADMIN_EMAIL_VMART=
SEED_ADMIN_EMAIL_SJI=
